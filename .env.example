# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# IMPORTANT for SEO: in production this must be your real https domain (e.g. https://axiosstation.com).
# Canonical URLs, the sitemap, hreflang and social previews are all built from it.

# Optional: IndexNow key (8-128 letters/digits/dashes, e.g. a random UUID without braces).
# When set in production, new/updated pages are announced to Bing, Yandex and other IndexNow engines.
INDEXNOW_KEY=

# ─── Database (MySQL 8+) ──────────────────────────────────────
DATABASE_URL="mysql://axios:change-me@127.0.0.1:3306/axios_station"

# ─── Redis (optional — site falls back to MySQL if unavailable) ─
REDIS_URL="redis://127.0.0.1:6379"
CACHE_TTL_SECONDS=300

# ─── Auth.js ──────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# ─── Initial Super Admin (used only by the seed script) ───────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME="Super Admin"
# Must be at least 12 characters. Never commit a real value.
SEED_ADMIN_PASSWORD=

# ─── Media storage ────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=public/uploads
UPLOAD_MAX_BYTES=10485760
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ─── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Axios Station <no-reply@example.com>"
LEAD_NOTIFICATION_EMAIL=

# ─── AI providers (server-side only, optional) ────────────────
AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
